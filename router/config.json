      "effort": "high",
      "max_tokens": 8000,
      "provider": {"data_collection": "deny"}
    },
    "sensitive": {
      "about": "Prompts containing PAN / Aadhaar / phone / email. Zero-data-retention endpoints only; fails closed if none exist.",
