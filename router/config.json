      "effort": "high",
      "max_tokens": 8000,
      "provider": {"data_collection": "deny"},
      "downgrade_to": "simple"
    },
    "hard": {
      "about": "WVS / mutual fund / insurance content (SEBI, AMFI, IRDAI). Strong non-Chinese model, never auto-downgraded.",
